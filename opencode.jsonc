{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "senior-hexa-developer",
    "skills": {
        "paths": ["skills"]
    },
    "provider": {
        "epfl": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "EPFL Inference",
            "env": [
                "EPFL_RCP_API_KEY"
            ],
            "options": {
                "baseURL": "https://<your-inference-endpoint>/v1"
            },
            "models": {
                "openai/gpt-oss-120b": {
                    "name": "GPT OSS 120b"
                },
                "moonshotai/Kimi-K2.7-Code": {
                    "name": "Kimi K2.7 Code"
                },
                "zai-org/GLM-5.2": {
                    "name": "Zai GLM 5.2"
                }
            }
        }
    },
    "model": "Kimi-K2.7-Code",
    "permission": {
        "bash": {
            "pwd": "allow",
            "ls": "allow",
            "tree": "allow",
            "find": "allow",
            "cat": "allow",
            "head": "allow",
            "tail": "allow",
            "grep": "allow",
            "rg": "allow",
            "git status": "allow",
            "git diff": "allow",
            "git log": "allow",
            "git show": "allow",
            "pytest": "allow",
            "ruff": "allow",
            "mypy": "allow"
        },
        "edit": "ask",
        "write": "ask"
    }
}

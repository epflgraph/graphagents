{
    "$schema": "https://opencode.ai/config.json",
    "$comment": "Workspace DELTA over the global config (~/.config/opencode/opencode.jsonc). Machine-specific values (model provider, endpoints, API keys) live ONLY in the global config - never duplicate them here.",
    "default_agent": "senior-hexa-developer",
    "skills": {
        "paths": [
            "skills"
        ]
    },
    "references": {
        "dbclient": {
            "path": "~/dev/graphdb-client",
            "description": "Graph DB Client repo (MySQL/MariaDB CLI utility) — owned by the database-engineer agent (Ecco). Use for its source, config contract, CLI commands, and tests.",
            "hidden": true
        },
        "grapharchitecture": {
            "path": "~/dev/grapharchitecture",
            "description": "Graph Architecture repo (C4 platform architecture graph files + React Flow canvas) — owned by the senior-software-architect agent (Filippo). Use for platform.graph.yaml, services/*.graph.yaml, schema/v1.json, validate_graph.py, and the canvas app.",
            "hidden": true
        },
        "graphauth": {
            "path": "~/dev/graphauth",
            "description": "GraphAuth repo (centralized authentication & access management: gk- API keys, wildcarded tuple-pattern grants, FastAPI PDP + MariaDB store, Authentik Phase 1) — owned by the cybersecurity-engineer agent (Guy). Use for its source, security model, schema, tests, and security tooling.",
            "hidden": true
        },
        "graphsecurity": {
            "path": "~/dev/graphsecurity",
            "description": "GraphSecurity repo (platform security tooling & automation: secret detection, code scanning, vulnerability assessment, intrusion testing — greenfield, owned by the cybersecurity-engineer agent Guy).",
            "hidden": true
        }
    },
    "permission": {
        "bash": {
            "pwd": "allow",
            "ls": "allow",
            "tree": "allow",
            "find": "allow",
            "cat": "allow",
            "head": "allow",
            "tail": "allow",
            "grep": "allow",
            "rg": "allow",
            "git status": "allow",
            "git diff": "allow",
            "git log": "allow",
            "git show": "allow",
            "pytest": "allow",
            "ruff": "allow",
            "mypy": "allow"
        },
        "edit": "ask",
        "write": "ask"
    },
    "lsp": {
        "pyright": {
            "command": [
                "pyright-langserver",
                "--stdio"
            ],
            "extensions": [
                ".py",
                ".pyi"
            ]
        }
    }
}